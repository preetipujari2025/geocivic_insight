# Django
SECRET_KEY=your-secret-key-here
DEBUG=True

# GDAL / PostGIS
# Windows: point to the GDAL DLL installed with OSGeo4W or standalone GDAL
# Example paths (adjust to your actual installation):
#   OSGeo4W:        C:/OSGeo4W/bin/gdal309.dll
#   Conda:          C:/Users/<you>/anaconda3/Library/bin/gdal309.dll
#   Standalone:     C:/Program Files/GDAL/gdal309.dll
GDAL_LIBRARY_PATH=C:/OSGeo4W/bin/gdal309.dll
